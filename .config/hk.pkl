// * HK - Git Hook Configuration
// This file ensures you are committing properly linted and formatted files which will pass ci
amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"

import "generated/generated.pkl"

steps =
  generated.addSteps((generated.steps) {
    ["[lint] file extensions"] {
      exclude = generated.steps["[lint] file extensions"].exclude + List("tests/fixtures/**")
    }
  })
